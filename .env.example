# ==========================================
# BACKEND ENVIRONMENT (Render / Railway)
# ==========================================
PORT=5000

# Cloud MySQL URL (Provided by Railway, Aiven, PlanetScale, etc.)
# If provided, DATABASE_URL takes priority over individual DB_* variables:
# DATABASE_URL=mysql://user:password@host:port/database
# DB_SSL=true

# Individual MySQL connection (e.g. local XAMPP or custom MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=imaz_homes
DB_SSL=false

# LIVE PAYMENT GATEWAY (Optional - server only)
PAYMENT_GATEWAY_URL=
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ==========================================
# FRONTEND ENVIRONMENT (Vercel)
# ==========================================
# Set this in Vercel Project Settings -> Environment Variables
# Pointing to your deployed backend API URL (without trailing slash)
VITE_API_BASE_URL=https://your-backend-app.onrender.com
